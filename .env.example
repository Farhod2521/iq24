# ── PostgreSQL ──
POSTGRES_DB=qanot
POSTGRES_USER=qanot
POSTGRES_PASSWORD=parol

# ── Ports on this computer (frontend site, backend API) ──
FRONTEND_PORT=3080
BACKEND_PORT=8080

# ── Backend ──
JWT_SECRET=uzun-tasodifiy-satr
PUBLIC_URL=http://localhost:3080
COOKIE_SECURE=false

# ── Telegram bot ──
TELEGRAM_BOT_TOKEN=

# ── Google OAuth (console.cloud.google.com → Credentials → OAuth client ID → Web application)
# Authorized redirect URI: http://localhost:3080/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Superadmin (/superadmin panel) — comma-separated Telegram IDs and/or Google e-mails
SUPERADMIN_TELEGRAM_IDS=
SUPERADMIN_EMAILS=

# ── AI test generator ── any provider: URL + key + model
# AI_FORMAT: openai    — OpenAI-style API (most providers; URL usually ends with /v1)
#            anthropic — Claude-style API
# Example URLs: https://api.openai.com/v1 · https://api.deepseek.com · https://api.anthropic.com
AI_URL=
AI_KEY=
AI_MODEL=
AI_FORMAT=openai
